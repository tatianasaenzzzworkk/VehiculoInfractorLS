<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/layoutHeaderDetalle"
            style="@style/SMT.Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTituloDetalle"
                style="@style/SMT.Text.ScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detalle de Infracción" />

            <TextView
                android:id="@+id/tvDetallePlacaHeader"
                style="@style/SMT.Text.SubtitleDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTituloDetalle"
                android:layout_marginTop="4dp"
                android:text="Placa: —" />

        </RelativeLayout>

        <!-- GRAVEDAD -->
        <RelativeLayout
            android:id="@+id/layoutGravedad"
            style="@style/SMT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutHeaderDetalle"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvLabelGravedad"
                style="@style/SMT.Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Nivel de gravedad" />

            <TextView
                android:id="@+id/tvDetalleGravedad"
                style="@style/SMT.Badge.Detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="GRAVE" />

        </RelativeLayout>

        <!-- DATOS VEHÍCULO -->
        <LinearLayout
            android:id="@+id/layoutDatosVehiculo"
            style="@style/SMT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutGravedad"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SMT.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="DATOS DEL VEHÍCULO" />

            <!-- PLACA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/labelPlaca"
                    style="@style/SMT.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Placa" />

                <TextView
                    android:id="@+id/tvDetallePlaca"
                    style="@style/SMT.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="ABC-123" />

            </RelativeLayout>

            <!-- INFRACCIÓN -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/labelInfraccion"
                    style="@style/SMT.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de infracción" />

                <TextView
                    android:id="@+id/tvDetalleTipoInfraccion"
                    style="@style/SMT.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Exceso de velocidad" />

            </RelativeLayout>

            <!-- VELOCIDAD REGISTRADA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/labelVelReg"
                    style="@style/SMT.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vel. registrada" />

                <TextView
                    android:id="@+id/tvDetalleVelocidadReg"
                    style="@style/SMT.Text.ValueRed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="95 km/h" />

            </RelativeLayout>

            <!-- VELOCIDAD PERMITIDA -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/labelVelPerm"
                    style="@style/SMT.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vel. permitida" />

                <TextView
                    android:id="@+id/tvDetalleVelocidadPerm"
                    style="@style/SMT.Text.ValueGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="60 km/h" />

            </RelativeLayout>

            <!-- EXCESO -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/labelExceso"
                    style="@style/SMT.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exceso" />

                <TextView
                    android:id="@+id/tvDetalleExceso"
                    style="@style/SMT.Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="35 km/h" />

            </RelativeLayout>

        </LinearLayout>

        <!-- UBICACIÓN -->
        <LinearLayout
            android:id="@+id/layoutUbicacion"
            style="@style/SMT.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutDatosVehiculo"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                style="@style/SMT.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="LOCALIZACIÓN" />

            <TextView
                android:id="@+id/tvDetalleUbicacion"
                style="@style/SMT.Text.Location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📍 Av. Boyacá Km 3" />

            <TextView
                android:id="@+id/tvDetalleFecha"
                style="@style/SMT.Text.Date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 2025-05-01" />

        </LinearLayout>

        <!-- BOTÓN -->
        <Button
            android:id="@+id/btnVolver"
            style="@style/SMT.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutUbicacion"
            android:layout_marginTop="16dp"
            android:text="Volver" />

    </RelativeLayout>

</ScrollView>