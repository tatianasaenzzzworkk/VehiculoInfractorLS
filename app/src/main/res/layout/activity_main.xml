<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1565C0"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMT – Infracciones"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tvTitulo"
                android:layout_marginTop="4dp"
                android:text="Sistema de Monitoreo de Tráfico"
                android:textColor="#BBDEFB"
                android:textSize="13sp" />

        </RelativeLayout>

        <!-- CONTENEDOR TARJETAS -->
        <LinearLayout
            android:id="@+id/layoutTarjetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutHeader"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- TARJETA 1 -->
            <RelativeLayout
                android:id="@+id/cardVehiculo1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlaca1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC-123"
                    android:textColor="#1565C0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGravedad1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="#D32F2F"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="GRAVE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfraccion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvPlaca1"
                    android:layout_marginTop="6dp"
                    android:text="Exceso de velocidad"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUbicacion1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvInfraccion1"
                    android:layout_marginTop="4dp"
                    android:text="📍 Av. Boyacá Km 3"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDetalle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvUbicacion1"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1565C0"
                    android:text="Ver detalle"
                    android:textColor="#FFFFFF" />

            </RelativeLayout>

            <!-- TARJETA 2 -->
            <RelativeLayout
                android:id="@+id/cardVehiculo2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlaca2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEF-456"
                    android:textColor="#1565C0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGravedad2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="#D32F2F"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="GRAVE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfraccion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvPlaca2"
                    android:layout_marginTop="6dp"
                    android:text="Exceso de velocidad"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUbicacion2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvInfraccion2"
                    android:layout_marginTop="4dp"
                    android:text="📍 Troncal Norte Km 7"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDetalle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvUbicacion2"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1565C0"
                    android:text="Ver detalle"
                    android:textColor="#FFFFFF" />

            </RelativeLayout>

            <!-- TARJETA 3 -->
            <RelativeLayout
                android:id="@+id/cardVehiculo3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlaca3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XYZ-789"
                    android:textColor="#1565C0"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGravedad3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="#F57C00"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="LEVE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfraccion3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvPlaca3"
                    android:layout_marginTop="6dp"
                    android:text="Semáforo en rojo"
                    android:textColor="#555555"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvUbicacion3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvInfraccion3"
                    android:layout_marginTop="4dp"
                    android:text="📍 Cra. 30 con Cll 72"
                    android:textColor="#888888"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDetalle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvUbicacion3"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#1565C0"
                    android:text="Ver detalle"
                    android:textColor="#FFFFFF" />

            </RelativeLayout>

        </LinearLayout>

    </RelativeLayout>

</ScrollView>
